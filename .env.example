# Required at build time for published articles and at runtime for comments/contact.
# Server-only backend URL. Include the backend's /v1 prefix and no trailing slash.
# Use a backend reachable from the build runner/container for production builds.
API_URL=http://localhost:8000/v1
# Obtain the explainit.tech key from Admin > Settings > Host sites.
PUBLIC_APP_KEY=replace_with_local_explainit_tech_key
